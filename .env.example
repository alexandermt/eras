# Copy this file to .env and fill in the values

# MariaDB
MARIADB_ROOT_PASSWORD=rootpassword
MARIADB_USER=eras
MARIADB_PASSWORD=eras_password
MARIADB_DB=eras

# Oracle ITS (read-only)
ORACLE_DSN=oracle-host:1521/ORCL
ORACLE_USER=eras_readonly
ORACLE_PASSWORD=change_me

# LDAP / Active Directory
LDAP_SERVER=ldap://ldap-host:389
LDAP_BASE_DN=dc=example,dc=com
LDAP_BIND_DN=cn=eras-svc,dc=example,dc=com
LDAP_BIND_PASSWORD=change_me
LDAP_USER_SEARCH_BASE=ou=users,dc=example,dc=com
LDAP_USER_ATTR=sAMAccountName
LDAP_GROUP_SEARCH_BASE=ou=groups,dc=example,dc=com
LDAP_SELECTOR_GROUP=cn=eras-selectors,ou=groups,dc=example,dc=com
LDAP_ADMIN_GROUP=cn=eras-admins,ou=groups,dc=example,dc=com

# Application
SECRET_KEY=change_me_to_a_strong_random_32char_key
ACCESS_TOKEN_EXPIRE_MINUTES=480

# CORS (comma-separated JSON list)
CORS_ORIGINS=["http://localhost:3000","https://eras.yourdomain.com"]
